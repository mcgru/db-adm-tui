# MongoDB 8.2 single-node replica set. Test-only credentials.
MONGO_PORT=57017
MONGO_REPLICA_SET=rs0
# Host and port advertised by the replica set. Keep localhost:MONGO_PORT when
# clients reach the server through an SSH tunnel. For direct access use the
# server's resolvable hostname and port instead.
MONGO_REPLICA_HOST=localhost:57017

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=mongo_root_test_password

# Admin able to manage users and roles, but not the root user.
MONGO_ADMIN_USERNAME=mongo_admin
MONGO_ADMIN_PASSWORD=mongo_admin_test_password

# Ordinary users.
MONGO_APP_USERNAME=app_user
MONGO_APP_PASSWORD=mongo_app_test_password
MONGO_ANALYST_USERNAME=analyst
MONGO_ANALYST_PASSWORD=mongo_analyst_test_password
