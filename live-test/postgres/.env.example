# PostgreSQL 18 test instance. Test-only credentials; change before exposing.
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pg_root_test_password
POSTGRES_DB=postgres

# Cluster admin used to exercise the access matrix (CREATEROLE + object owner).
PG_ADMIN_USER=db_admin
PG_ADMIN_PASSWORD=db_admin_test_password

# Ordinary login users.
PG_APP_USER=app_user
PG_APP_PASSWORD=pg_app_test_password
PG_ANALYST_USER=analyst
PG_ANALYST_PASSWORD=pg_analyst_test_password
