# MariaDB 11.4 test instance. Test-only credentials; change before exposing.
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=mariadb_root_test_password
MARIADB_ROOT_HOST=%
MARIADB_DATABASE=appdb

# Server-wide admin used to exercise the access matrix.
MARIADB_ADMIN_USER=mdb_admin
MARIADB_ADMIN_PASSWORD=mdb_admin_test_password

# Ordinary login users.
MARIADB_APP_USER=app_user
MARIADB_APP_PASSWORD=mdb_app_test_password
MARIADB_ANALYST_USER=analyst
MARIADB_ANALYST_PASSWORD=mdb_analyst_test_password
